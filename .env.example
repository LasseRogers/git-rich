POSTGRES_PASSWORD=change-me
POSTGRES_DB=esports
POSTGRES_PORT=5432

MLFLOW_PORT=5050
API_PORT=8000
PANEL_PORT=8501

# Google service account key for downloading match data (see README).
GOOGLE_CREDENTIALS=

# Phone alerts through ntfy.sh (see docs/alerts.md). Leave NTFY_TOPIC empty to turn them all off.
NTFY_TOPIC=
ALERT_FAILURES=true
ALERT_UNMAPPED_TEAMS=true
ALERT_WORSE_MODEL=true
ALERT_NEW_BETS=true

# OCI Object Storage bucket for weekly backups (see docs/backup.md). Leave empty to skip them.
BACKUP_BUCKET=
